# Android / Gradle build output
build/
app/build/
.gradle/
*.apk
*.aab
local.properties

# Signing material, should any ever appear here
*.keystore
*.jks
keystore.properties

# Valhalla's working directory: a 100 MB OSM extract and the routing graph built
# from it, both regenerated by `docker compose up`. Never in version control.
tools/custom_files/
tools/valhalla_tiles/

# Prepared bundles and offline map packs are outputs, not sources.
*.mbtiles

# Screens captured for design review; regenerate rather than version 35 MB of PNGs.
docs/screens/design/

# Design handoff bundles. Kept out because a zip cannot be diffed or browsed on
# GitHub; unzip it into docs/design/ and commit that if it is worth publishing.
docs/design/

# Editors and OS
.idea/
*.iml
.DS_Store
__pycache__/
.pytest_cache/
